set nocompatible

let mapleader = "/"
let maplocalleader = "//"

syntax on

if has('termguicolors') && !has('gui_running') && !has('mac')
	" tmux-256color is not xterm-like, so Vim won't fill these in itself
	if empty(&t_8f)
		let &t_8f = "\<Esc>[38;2;%lu;%lu;%lum"
		let &t_8b = "\<Esc>[48;2;%lu;%lu;%lum"
	endif
	set termguicolors
endif

color verde

set tabstop=8
set softtabstop=8
set shiftwidth=8
" set expandtab
set incsearch
set viminfo=""
set ruler
set noswapfile
set encoding=utf-8
set fileencoding=utf-8
set autoindent
set smartindent
" set laststatus=2
set hidden
set wildmenu

set tags=tags;$HOME

autocmd FileType make set noexpandtab

set makeprg=cmake\ --build\ build

autocmd QuickFixCmdPost [^l]* cwindow

let g:fzf_layout = { 'down':  '40%'}

let g:fzf_force_termguicolors = &termguicolors
let g:fzf_colors = {
	\ 'fg':      ['fg', 'Normal'],
	\ 'bg':      ['bg', 'Normal'],
	\ 'hl':      ['fg', 'Comment'],
	\ 'fg+':     ['fg', 'Visual'],
	\ 'bg+':     ['bg', 'Visual'],
	\ 'hl+':     ['fg', 'Constant'],
	\ 'info':    ['fg', 'Comment'],
	\ 'prompt':  ['fg', 'Statement'],
	\ 'pointer': ['fg', 'Statement'],
	\ 'marker':  ['fg', 'Constant'],
	\ 'spinner': ['fg', 'Comment'],
	\ 'header':  ['fg', 'Comment'] }

nnoremap <leader>f :Files<CR>
nnoremap <leader>b :Buffers<CR>
nnoremap <leader>g :RG<CR>
nnoremap <leader>w :Rg <C-r><C-w><CR>
xnoremap <silent> <leader>g "zy:execute 'Rg ' . escape(@z, '\.^$*+?()[]{}<Bar>')<CR>
nnoremap <leader>t :Tags<CR>
nnoremap <leader>T :BTags<CR>
nnoremap <leader>] :Tags <C-r><C-w><CR>
