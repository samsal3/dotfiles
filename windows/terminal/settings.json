// Windows Terminal settings. Goes in:
//   %LOCALAPPDATA%\Packages\Microsoft.WindowsTerminal_8wekyb3d8bbwe\LocalState\settings.json
// The "verde" color scheme comes from verde.json (a fragment) in this folder.
{
    "$schema": "https://aka.ms/terminal-profiles-schema",
    "defaultProfile": "{eaee8008-e622-4bc1-b555-aaa60bcb3cbf}",
    "profiles": {
        "defaults": {
            "colorScheme": "verde"
        },
        "list": [
            {
                "guid": "{eaee8008-e622-4bc1-b555-aaa60bcb3cbf}",
                "name": "PowerShell (vi)",
                // PSReadLine's vi editing mode; the cursor shape shows insert vs. normal.
                "commandline": "powershell.exe -NoLogo -NoExit -Command Set-PSReadLineOption -EditMode Vi -ViModeIndicator Cursor"
            }
        ]
    }
}
